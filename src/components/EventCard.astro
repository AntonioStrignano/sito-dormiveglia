---
import type { ProgramEvent } from "../data/programma";
import { site } from "../data/site";

interface Props {
  event: ProgramEvent;
}

const { event } = Astro.props;
const dateParts = event.day.match(/^(.*?)(\d+)(.*)$/);
---

<li class="event-item">
  <div>
    <p class="eyebrow event-day">
      {dateParts ? (
        <span>{dateParts[1]}<span class="date-number">{dateParts[2]}</span>{dateParts[3]}</span>
      ) : event.day}
    </p>
    <p class="event-meta">Ingresso {event.doors} · Proiezione {event.screening}</p>
  </div>
  <div>
    <h3 class="event-title">{event.title}</h3>
    <p class="muted">{event.kind} · {site.venue}, {site.address}</p>
    <div class="program-event-details">
      <p class="event-meta">{event.details.country} · {event.details.year} · {event.details.duration}</p>
      <p class="event-meta">{event.details.categories.join(" · ")}</p>
      <p>{event.details.synopsis}</p>
      <ul class="program-event-credits">
        {event.details.credits.map((credit) => (
          <li><strong>{credit.label}:</strong> {credit.value}</li>
        ))}
      </ul>
      {event.details.award && <p><strong>Riconoscimento:</strong> {event.details.award}</p>}
    </div>
  </div>
  <div>
    {site.bookingFormUrl ? (
      <a href={site.bookingFormUrl} target="_blank" rel="noreferrer">Prenota un posto</a>
    ) : (
      <p class="muted">Prenotazione online in aggiornamento</p>
    )}
    <p class="event-meta">Ingresso gratuito fino a esaurimento posti</p>
  </div>
</li>