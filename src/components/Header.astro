---
import { Image } from "astro:assets";
import { navigation, site } from "../data/site";
import festivalLogo from "../assets/logo/logo.png";

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) =>
  href.startsWith("/gertie-animation-prize/")
    ? currentPath.startsWith("/gertie-animation-prize/")
    : currentPath === href;
---

<header class="site-header">
  <div class="site-header-inner">
    <a class="brand" href="/" aria-label={`${site.name}, homepage`}>
      <Image class="brand-logo" src={festivalLogo} alt="" />
    </a>
    <nav class="desktop-nav" aria-label="Navigazione principale">
      <ul class="nav-list">
        {navigation.map((item) => (
          <li>
            <a href={item.href} aria-label={item.ariaLabel} aria-current={isCurrent(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="header-actions">
      <a
        class="button button-primary nav-cta"
        href={site.bookingFormUrl}
        target="_blank"
        rel="noreferrer"
        aria-label="Prenota un posto (si apre in una nuova scheda)"
      >
        Prenota{" "}<span class="nav-cta-extra">un posto</span>
      </a>
      <details class="mobile-nav">
        <summary aria-label="Apri navigazione">Menu</summary>
        <nav aria-label="Navigazione principale">
          <ul class="nav-list">
            {navigation.map((item) => (
              <li>
                <a href={item.href} aria-label={item.ariaLabel} aria-current={isCurrent(item.href) ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const mobileNav = document.querySelector<HTMLDetailsElement>(".mobile-nav");

  mobileNav?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("nav a")) mobileNav.open = false;
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !mobileNav?.open) return;
    mobileNav.open = false;
    mobileNav.querySelector("summary")?.focus();
  });
</script>