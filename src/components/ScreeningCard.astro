---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { ProgramEvent } from "../data/programma";
import { site } from "../data/site";

interface Props {
  event: ProgramEvent;
  poster: ImageMetadata;
  dialogId: string;
}

const { event, poster, dialogId } = Astro.props;
---

<li>
  <button
    type="button"
    class="screening-card"
    aria-haspopup="dialog"
    aria-controls={dialogId}
    data-terminal-dialog-trigger
  >
    <Image
      class="screening-poster"
      src={poster}
      alt={`Immagine del film ${event.title}`}
      loading="lazy"
    />
    <span class="eyebrow">{event.day}</span>
    <span class="screening-title">{event.title}</span>
    <span class="event-meta">Porte {event.doors} · Proiezione {event.screening}</span>
    <span class="screening-action">Dettagli e prenotazione</span>
  </button>

  <dialog
    class="screening-dialog jury-dialog"
    id={dialogId}
    aria-labelledby={`${dialogId}-title`}
    data-terminal-dialog
  >
    <button class="dialog-close" type="button" aria-label="Chiudi dettagli">&times;</button>
    <div class="dialog-content jury-dialog-content screening-dialog-content">
      <header class="jury-dialog-heading screening-dialog-heading">
        <Image
          class="screening-dialog-poster"
          src={poster}
          alt={`Immagine del film ${event.title}`}
          loading="lazy"
        />
        <h2 id={`${dialogId}-title`} data-dossier-typewriter>{event.title}</h2>
      </header>
      <section class="screening-dialog-info" aria-label={`Informazioni sulla proiezione di ${event.title}`}>
        <p class="screening-dialog-meta" data-dossier-typewriter>{event.details.year} · {event.details.duration}</p>
        <p class="screening-dialog-meta" data-dossier-typewriter>{event.day} · Proiezione {event.screening}</p>
      </section>
      <section class="jury-dialog-bio screening-dialog-details" aria-label={`Sinossi di ${event.title}`}>
        <p class="eyebrow" data-dossier-typewriter>LOG // SINOSSI</p>
        <p data-dossier-typewriter>{event.details.synopsis}</p>
      </section>
      <div class="screening-dialog-footer">
        <p class="event-meta">{site.venue} · {site.address}<br />Ingresso gratuito fino a esaurimento posti.</p>
        <nav class="dialog-actions" aria-label={`Azioni per ${event.title}`}>
          <a class="button button-primary" href={site.bookingFormUrl} target="_blank" rel="noreferrer">Prenota un posto</a>
          <a class="button button-secondary" href={`/programma/#${event.id}`}>Consulta il programma</a>
        </nav>
      </div>
    </div>
  </dialog>
</li>

<script>
  import { initializeTerminalDialogs } from "../scripts/terminalDialogs";

  initializeTerminalDialogs();
</script>
