---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

import { site } from "../data/site";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image = "/images/og-dormiveglia.jpg",
  imageAlt = "Illustrazione della locandina del Dormiveglia Animation Film Fest 2026: un robot con mantello nel deserto",
  noindex = false,
} = Astro.props;
const pageTitle = title.startsWith("Dormiveglia") ? title : `${title} | Dormiveglia`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const isHome = Astro.url.pathname === "/";
const segments = Astro.url.pathname.split("/").filter(Boolean);

const organization = {
  "@type": "Organization",
  "@id": new URL("/#organization", Astro.site).href,
  name: site.owner.name,
  email: site.owner.email,
  sameAs: [site.contacts.collectiveInstagram],
};

const jsonLd: Record<string, unknown>[] = [];
if (isHome) {
  jsonLd.push(
    { "@context": "https://schema.org", ...organization },
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: site.name,
      url: new URL("/", Astro.site).href,
      inLanguage: "it",
      publisher: { "@id": organization["@id"] },
    },
    {
      "@context": "https://schema.org",
      "@type": "Festival",
      name: `${site.name} 2026`,
      startDate: "2026-11-12",
      endDate: "2026-11-15",
      eventStatus: "https://schema.org/EventScheduled",
      eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
      isAccessibleForFree: true,
      inLanguage: "it",
      image: ogImage.href,
      description,
      location: {
        "@type": "Place",
        name: site.venue,
        address: { "@type": "PostalAddress", streetAddress: "Via S. Francesco 12", addressLocality: "Andria", addressCountry: "IT" },
      },
      organizer: { "@id": organization["@id"] },
    },
  );
} else if (segments.length === 1 && !noindex) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
      { "@type": "ListItem", position: 2, name: title, item: canonicalUrl.href },
    ],
  });
}
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/webp" href="/images/dormiveglia-profile.webp" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content="Dormiveglia Animation Film Fest" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title>{pageTitle}</title>
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <script is:inline data-goatcounter="https://dormivegliafest.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Salta al contenuto</a>
    <Header />
    <main id="main-content" class="page-shell">
      <slot />
    </main>
    <Footer />
  </body>
</html>