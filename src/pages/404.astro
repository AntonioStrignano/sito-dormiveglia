---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Pagina non trovata" description="La pagina che cerchi non esiste.">
  <div class="legal-page">
    <p class="eyebrow">Errore 404</p>
    <h1>Pagina non trovata</h1>
    <p>Il link potrebbe essere errato o la pagina spostata.</p>
    <div class="not-found-actions">
      <a class="button button-primary" href="/">Torna alla home</a>
    </div>
  </div>
</BaseLayout>
