---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { archiveEditions } from "../data/archivio";
import artwork from "../assets/hero/hero-desktop.png";
---

<BaseLayout title="Archivio" description="I ricordi del Dormiveglia Animation Film Fest: i recap delle edizioni 2026 e 2025.">
  <div class="archive-page">
    <header class="archive-heading">
      <p class="eyebrow">Dormiveglia Animation Film Fest</p>
      <h1>Archivio</h1>
      <nav class="archive-years" aria-label="Edizioni del festival">
        {archiveEditions.map(({ year }) => <a href={`#edizione-${year}`}>{year}</a>)}
      </nav>
    </header>
    <Image class="archive-banner" src={artwork} alt="La grafica dell'edizione 2026 del Dormiveglia Animation Film Fest." />
    {archiveEditions.map((edition) => (
      <section id={`edizione-${edition.year}`} class="archive-edition" aria-labelledby={`edition-title-${edition.year}`}>
        <header>
          <p class="eyebrow">Dormiveglia // {edition.year}</p>
          <h2 id={`edition-title-${edition.year}`}>{edition.year}</h2>
          {edition.year === 2026 && <a class="button button-primary archive-gertie-link" href="/gertie-animation-prize/2026/#premi">I premi Gertie 2026 <span aria-hidden="true">&#8594;</span></a>}
        </header>
        <ul class="archive-recaps">
          {edition.recaps.map((recap, index) => (
            <li>
              <a href={recap.href} target="_blank" rel="noreferrer" aria-label={`${recap.title}, Dormiveglia ${edition.year}: guarda il reel su Instagram (nuova scheda)`}>
                <span class="archive-recap-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                <span><strong>{recap.title}</strong><span class="archive-recap-source">Instagram / Reel</span></span>
                <span class="archive-recap-arrow" aria-hidden="true">&#8599;</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>