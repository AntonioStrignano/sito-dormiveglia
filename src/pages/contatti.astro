---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { site } from "../data/site";
import venuePhoto from "../assets/venue/ingresso.png";
---

<BaseLayout
  title="Contatti"
  description="Sede, orari, prenotazioni e contatti del Dormiveglia Animation Film Fest ad Andria."
>
  <div class="contacts-page">
  <p class="eyebrow">{site.dates}</p>
  <h1>Contatti</h1>

  <section class="content-section venue-section" aria-labelledby="venue-title">
    <div class="venue-layout">
      <div class="venue-copy">
        <h2 id="venue-title">Dove e quando</h2>
        <p class="venue-name">{site.venue}</p>
        <address>{site.address}</address>

        <dl class="event-facts">
          <div>
            <dt>Orari</dt>
            <dd>Porte 20:00<br />Proiezioni 21:00</dd>
          </div>
          <div>
            <dt>Ingresso</dt>
            <dd>Gratuito, prenotazione consigliata</dd>
          </div>
          <div>
            <dt>Posti</dt>
            <dd>Circa 40 per serata</dd>
          </div>
        </dl>

        <div class="venue-actions">
          <a
            class="button button-secondary directions-link"
            href={site.googleMapsUrl}
            target="_blank"
            rel="noreferrer"
            aria-label="Apri le indicazioni per Andria Food Policy Hub su Google Maps"
          >
            <svg
              aria-hidden="true"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="square"
              stroke-linejoin="miter"
              shape-rendering="crispEdges"
            >
              <path d="M11 22h2v-2h2v-2h2v-3h2V8h-2V5h-3V3H9v2H6v3H4v6h2v3h2v2h2v2h1z" />
              <path d="M10 8h4v4h-4z" />
            </svg>
            <span>Indicazioni</span>
          </a>
          <a class="button button-primary" href={site.bookingFormUrl}>Prenota un posto</a>
        </div>
      </div>

      <figure class="venue-photo">
        <Image
          src={venuePhoto}
          alt="Facciata dell’Andria Food Policy Hub, con frecce che indicano l’ingresso."
          widths={[640, 960, 1280]}
          sizes="(min-width: 64rem) 50vw, 100vw"
          loading="lazy"
        />
        <figcaption>Le frecce nell’immagine indicano l’ingresso della sede.</figcaption>
      </figure>
    </div>
  </section>

  <div class="secondary-grid">
    <section class="content-section" aria-labelledby="accessibility-title">
      <h2 id="accessibility-title">Accessibilità</h2>
      <ul>
        <li>La sede è dotata di una rampa per carrozzine.</li>
        <li>È presente un bagno accessibile a persone con disabilità.</li>
      </ul>
    </section>

    <section class="content-section" aria-labelledby="contact-title">
      <h2 id="contact-title">Scrivici</h2>
      <ul class="contact-list">
        <li><span>Email festival</span><a href={`mailto:${site.contacts.festivalEmail}`}>{site.contacts.festivalEmail}</a></li>
        <li><span>Email collettivo KA-POW!</span><a href={`mailto:${site.contacts.collectiveEmail}`}>{site.contacts.collectiveEmail}</a></li>
      </ul>
      <ul class="social-list">
        <li><a href={site.contacts.instagram} target="_blank" rel="noreferrer">Instagram Dormiveglia</a></li>
        <li><a href={site.contacts.collectiveInstagram} target="_blank" rel="noreferrer">Instagram collettivo KA-POW!</a></li>
      </ul>
    </section>
  </div>
  </div>
</BaseLayout>