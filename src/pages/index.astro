---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ScreeningCard from "../components/ScreeningCard.astro";
import PreviewCarousel from "../components/PreviewCarousel.astro";
import { juryPreviews, shortFilmPreviews } from "../data/gertie";
import { program } from "../data/programma";
import { site } from "../data/site";
import heroArtwork from "../../Grafiche dormiveglia/heros/AndriaSmart_ Locandina Dormiveglia 26.png";
import festivalLogo from "../../Grafiche dormiveglia/loghi_screenshot/solo_logo.png";
import gertieBanner from "../../Grafiche gertie/Gertie banner.webp";
import valleyPoster from "../../Grafiche dormiveglia/locandine film/Film_Valle incantata.png";
import lindaPoster from "../../Grafiche dormiveglia/locandine film/Film_ Linda e il Pollo.png";
import nikukoPoster from "../../Grafiche dormiveglia/locandine film/Film_ Nikuko.png";

const moviePosters: Record<string, ImageMetadata> = {
  "Alla ricerca della valle incantata": valleyPoster,
  "Linda e il pollo": lindaPoster,
  "La fortuna di Nikuko": nikukoPoster,
};
const screenings = program.filter((event) => event.kind === "Proiezione");
---

<BaseLayout
  title="Dormiveglia"
  description="Dormiveglia Animation Film Fest, seconda edizione, dal 12 al 15 novembre 2026 ad Andria."
>
  <script is:inline>
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.documentElement.classList.add("typewriter-ready");
    }
  </script>

  <section class="hero" aria-labelledby="home-title">
    <div class="hero-visual">
      <Image
        class="hero-image"
        src={heroArtwork}
        alt="Un viandante attraversa un paesaggio digitale notturno."
        fetchpriority="high"
      />
    </div>
    <div class="hero-copy">
      <h1 id="home-title" class="hero-title">
        <Image
          class="hero-logo"
          src={festivalLogo}
          alt="Dormiveglia Animation Film Fest"
          fetchpriority="high"
        />
      </h1>
      <p class="hero-terminal">
        <span class="sr-only">{site.edition} · Andria</span>
        <span class="typewriter-wrap">
          <span class="hero-terminal-text" data-typewriter aria-hidden="true">II EDIZIONE // ANDRIA</span>
        </span>
      </p>
      <p class="hero-intro">
        <span class="sr-only">Quattro serate dedicate al cinema d'animazione.</span>
        <span class="hero-intro-copy" aria-hidden="true">
          <span class="typewriter-wrap"><span data-typewriter>Quattro serate dedicate al cinema</span></span>{" "}<span class="typewriter-wrap hero-intro-ending"><span data-typewriter>d'animazione.</span></span>
        </span>
      </p>
      <div class="hero-facts">
        <p class="hero-date">
          <span class="sr-only">{site.dates}</span>
          <span class="typewriter-wrap"><span data-typewriter aria-hidden="true">{site.dates.toUpperCase()}</span></span>
        </p>
        <p class="hero-venue">
          <span class="sr-only">{site.venue}. {site.address}</span>
          <span class="typewriter-wrap"><span data-typewriter aria-hidden="true">{site.venue}</span></span>
          <span class="typewriter-wrap"><span data-typewriter aria-hidden="true">{site.address}</span></span>
        </p>
        <p>
          <span class="sr-only">Ingresso gratuito fino a esaurimento posti.</span>
          <span class="typewriter-wrap"><span data-typewriter aria-hidden="true">Ingresso gratuito fino a esaurimento posti.</span></span>
        </p>
      </div>
      <nav class="hero-actions" aria-label="Azioni principali">
        <a
          class="button button-primary"
          href={site.bookingFormUrl ?? "/programma/"}
          target={site.bookingFormUrl ? "_blank" : undefined}
          rel={site.bookingFormUrl ? "noreferrer" : undefined}
        >
          <span class="sr-only">Prenota un posto</span>
          <span class="typewriter-wrap"><span aria-hidden="true">Prenota un posto</span></span>
        </a>
        <a class="button button-secondary" href="/programma/">
          <span class="sr-only">Programma</span>
          <span class="typewriter-wrap"><span aria-hidden="true">Programma</span></span>
        </a>
      </nav>
    </div>
  </section>

  <section class="content-section" aria-labelledby="home-program-title">
    <p class="eyebrow">12-15 novembre 2026 · Andria</p>
    <h2 id="home-program-title">Le proiezioni</h2>
    <ul class="screening-grid">
      {screenings.map((event, index) => (
        <ScreeningCard
          event={event}
          poster={moviePosters[event.title]}
          dialogId={`screening-dialog-${index}`}
        />
      ))}
    </ul>
    <nav class="screening-actions" aria-label="Azioni sul programma">
      <a class="button button-secondary" href="/programma/">Consulta il programma</a>
      <a
        class="button button-primary"
        href={site.bookingFormUrl ?? "/programma/"}
        target={site.bookingFormUrl ? "_blank" : undefined}
        rel={site.bookingFormUrl ? "noreferrer" : undefined}
      >Prenota un posto</a>
    </nav>
  </section>

  <section class="gertie-feature" aria-labelledby="gertie-teaser-title">
    <Image
      class="gertie-banner-image"
      src={gertieBanner}
      alt="Banner illustrato del Gertie Animation Film Prize."
      loading="lazy"
    />
    <div class="gertie-teaser">
      <div>
        <p class="eyebrow">Sabato 14 novembre · 21:00</p>
        <h2 id="gertie-teaser-title">Gertie Animation Prize</h2>
        <p>Una serata dedicata ai corti d'animazione in selezione.</p>
      </div>
      <nav class="gertie-actions" aria-label="Esplora Gertie">
        <a class="button button-primary" href="/gertie-animation-prize/">Scopri Gertie</a>
        <a class="button button-secondary" href="/gertie-animation-prize/#edition-2025">Edizione 2025</a>
      </nav>
    </div>
  </section>

  <section class="content-section gertie-previews" aria-label="Anteprime del Gertie Animation Prize">
    <PreviewCarousel
      id="gertie-jury"
      title="La giuria"
      items={juryPreviews}
      mode="responsive"
    />
    <PreviewCarousel
      id="gertie-shorts"
      eyebrow="Selezione ufficiale"
      title="I corti selezionati"
      items={shortFilmPreviews}
      edgeBands
    />
  </section>

  <section class="content-section instagram-teaser" aria-labelledby="instagram-title">
    <div>
      <p class="eyebrow">Dal festival</p>
      <h2 id="instagram-title">Dormiveglia su Instagram</h2>
      <p class="muted">L'anteprima del feed arriverà qui. Intanto trovi tutti i post sul profilo del festival.</p>
    </div>
    <a
      class="button button-secondary"
      href={site.contacts.instagram}
      target="_blank"
      rel="noreferrer"
    >Apri @dormivegliafest</a>
  </section>
</BaseLayout>

<script>
  const typewriterLines = document.querySelectorAll<HTMLElement>("[data-typewriter]");

  const startTypewriterLine = (lineIndex = 0) => {
    const line = typewriterLines.item(lineIndex);
    if (!line) return;

    const wrapper = line.parentElement;
    const characterCount = line.textContent?.length ?? 0;
    if (!wrapper || !characterCount) {
      startTypewriterLine(lineIndex + 1);
      return;
    }

    wrapper.style.setProperty("--typewriter-width", `${line.scrollWidth}px`);
    wrapper.style.setProperty("--typewriter-steps", String(characterCount));
    wrapper.style.setProperty("--typewriter-duration", `${characterCount * 16}ms`);
    wrapper.style.setProperty("--typewriter-delay", "0ms");
    line.addEventListener("animationend", (event) => {
      if (event.animationName !== "typewriter-reveal") return;
      wrapper.classList.remove("is-typing");
      wrapper.classList.add("is-typed");
      startTypewriterLine(lineIndex + 1);
    }, { once: true });
    wrapper.classList.add("is-typing");
  };

  const startTypewriter = () => {
    startTypewriterLine();
  };

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    if (document.visibilityState === "visible") {
      startTypewriter();
    } else {
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "visible") startTypewriter();
      }, { once: true });
    }
  }

</script>