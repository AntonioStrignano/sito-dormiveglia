---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { program } from "../data/programma";
import { site } from "../data/site";
import heroArtwork from "../../Grafiche dormiveglia/heros/AndriaSmart_ Locandina Dormiveglia 26.png";
import valleyPoster from "../../Grafiche dormiveglia/locandine film/Film_Valle incantata.png";
import lindaPoster from "../../Grafiche dormiveglia/locandine film/Film_ Linda e il Pollo.png";
import nikukoPoster from "../../Grafiche dormiveglia/locandine film/Film_ Nikuko.png";

const moviePosters: Record<string, ImageMetadata> = {
  "Alla ricerca della valle incantata": valleyPoster,
  "Linda e il pollo": lindaPoster,
  "La fortuna di Nikuko": nikukoPoster,
};
const screenings = program.filter((event) => event.kind === "Proiezione");
---

<BaseLayout
  title="Dormiveglia"
  description="Dormiveglia Animation Film Fest, seconda edizione, dal 12 al 15 novembre 2026 ad Andria."
>
  <section class="hero" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="eyebrow">{site.edition} · {site.dates}</p>
      <h1 id="home-title">Dormiveglia Animation Film Fest</h1>
      <p>Quattro serate di cinema d'animazione ad Andria, al Food Policy Hub.</p>
      <p><strong>Ingresso gratuito fino a esaurimento posti.</strong></p>
      <nav class="hero-actions" aria-label="Azioni principali">
        <a
          class="button button-primary"
          href={site.bookingFormUrl ?? "/programma/"}
          target={site.bookingFormUrl ? "_blank" : undefined}
          rel={site.bookingFormUrl ? "noreferrer" : undefined}
        >Prenota un posto</a>
        <a class="button button-secondary" href="/programma/">Programma</a>
      </nav>
    </div>
    <Image
      class="hero-image"
      src={heroArtwork}
      alt="Illustrazione della seconda edizione del Dormiveglia Animation Film Fest con il viandante e i dettagli della rassegna."
      fetchpriority="high"
    />
  </section>

  <section class="content-section" aria-labelledby="home-program-title">
    <p class="eyebrow">12-15 novembre 2026 · Andria</p>
    <h2 id="home-program-title">Le proiezioni</h2>
    <ul class="screening-grid">
      {screenings.map((event) => (
        <li>
          <a
            class="screening-card"
            href={site.bookingFormUrl ?? "/programma/"}
            target={site.bookingFormUrl ? "_blank" : undefined}
            rel={site.bookingFormUrl ? "noreferrer" : undefined}
            aria-label={site.bookingFormUrl ? `Prenota un posto per ${event.title}` : `Dettagli della proiezione ${event.title}`}
          >
            <Image
              class="screening-poster"
              src={moviePosters[event.title]}
              alt={`Immagine del film ${event.title}`}
              loading="lazy"
            />
            <span class="eyebrow">{event.day}</span>
            <span class="screening-title">{event.title}</span>
            <span class="event-meta">Porte {event.doors} · Proiezione {event.screening}</span>
            <span class="screening-action">{site.bookingFormUrl ? "Prenota un posto" : "Dettagli della proiezione"}</span>
          </a>
        </li>
      ))}
    </ul>
    <p><a href="/programma/">Consulta il programma completo</a></p>
  </section>

  <section class="content-section gertie-teaser" aria-labelledby="gertie-teaser-title">
    <div>
      <p class="eyebrow">Sabato 14 novembre · 21:00</p>
      <h2 id="gertie-teaser-title">Gertie Animation Prize</h2>
      <p>Una serata dedicata ai corti d'animazione in selezione.</p>
    </div>
    <a class="gertie-link" href="/gertie-animation-prize/">Scopri Gertie</a>
  </section>
</BaseLayout>