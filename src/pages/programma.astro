---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProgramCard from "../components/ProgramCard.astro";
import type { ImageMetadata } from "astro";
import { program } from "../data/programma";
import { site } from "../data/site";
import valleyPoster from "../../Grafiche dormiveglia/locandine/valleincantanalocandina.jpg";
import lindaPoster from "../../Grafiche dormiveglia/locandine/lindalocandina.jpg";
import nikukoPoster from "../../Grafiche dormiveglia/locandine/nikukolocandina.jpg";
import gertiePoster from "../../Grafiche dormiveglia/locandine/gertielocandina.jpg";

const posters: Record<string, ImageMetadata> = {
  "giovedi-12": valleyPoster,
  "venerdi-13": lindaPoster,
  "sabato-14": gertiePoster,
  "domenica-15": nikukoPoster,
};

const eventsJsonLd = program.map((event) => ({
  "@context": "https://schema.org",
  "@type": "ScreeningEvent",
  name: event.title,
  startDate: `${event.date}T${event.screening}:00+01:00`,
  doorTime: event.doors,
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  isAccessibleForFree: true,
  inLanguage: "it",
  location: {
    "@type": "Place",
    name: site.venue,
    address: { "@type": "PostalAddress", streetAddress: "Via S. Francesco 12", addressLocality: "Andria", addressCountry: "IT" },
  },
  description: event.details.synopsis,
}));
---

<BaseLayout
  title="Programma"
  description="Il programma del Dormiveglia Animation Film Fest, dal 12 al 15 novembre 2026 ad Andria: tre film d'animazione e la serata del Gertie Animation Prize."
>
  <header>
    <p class="eyebrow">{site.dates} · {site.venue}</p>
    <h1>Programma</h1>
    <p>Ogni sera: ingresso alle 20:00, proiezione alle 21:00. Ingresso gratuito fino a esaurimento posti.</p>
  </header>

  <section class="content-section" aria-label="Serate del festival">
    <ol class="program-timeline">
      {program.map((event) => <ProgramCard event={event} poster={posters[event.id]} />)}
    </ol>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(eventsJsonLd)} />
</BaseLayout>
