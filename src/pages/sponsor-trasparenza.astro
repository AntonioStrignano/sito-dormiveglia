---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const documents = [
  {
    title: "Progetto del festival",
    description: "Presentazione della rassegna e delle sue attività.",
  },
  {
    title: "Proposta per sponsor e sostenitori",
    description: "Informazioni sulle opportunità di collaborazione.",
  },
  {
    title: "Budget e fabbisogno",
    description: "Quadro economico da pubblicare solo dopo verifica e approvazione.",
  },
  {
    title: "Progetti e rendicontazioni",
    description: "Materiali relativi alle attività e alle edizioni precedenti, se disponibili.",
  },
];
---

<BaseLayout
  title="Sponsor e trasparenza"
  description="Documenti di progetto e informazioni per sostenere il Dormiveglia Animation Film Fest."
>
  <p class="eyebrow">KA-POW! · Dormiveglia Animation Film Fest</p>
  <h1>Sponsor e trasparenza</h1>
  <p>Qui raccoglieremo i documenti del progetto e le informazioni utili a chi desidera sostenere il festival.</p>

  <section class="content-section" aria-labelledby="documents-title">
    <h2 id="documents-title">Documenti</h2>
    <ul class="document-list">
      {documents.map((document) => (
        <li class="document-item">
          <h3>{document.title}</h3>
          <p>{document.description}</p>
          <p class="muted">PDF da fornire.</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="content-section" aria-labelledby="sponsor-contact-title">
    <h2 id="sponsor-contact-title">Contatti</h2>
    {site.contacts.email ? (
      <p>Per informazioni sulle collaborazioni: <a href={`mailto:${site.contacts.email}`}>{site.contacts.email}</a></p>
    ) : (
      <p class="placeholder">Contatto per sponsor e collaborazioni: da aggiungere.</p>
    )}
  </section>
</BaseLayout>